#errorCatcher Echo
##
## Chart data for the "year" period. Consumed by js/weewx-dark.js.
##
## Emitted with encoding=utf8 (set in skin.conf); html_entities would corrupt
## the unit labels. Series come from WeeWX's .series() tag, which renders
## missing values as null on its own -- Chart.js draws those as gaps.
##
{
  "period": "year",
  "label": "This Year",
  "generated": ${current.dateTime.raw * 1000},
  "units": {
    "outTemp": "$unit.label.outTemp",
    "outHumidity": "$unit.label.outHumidity",
    "windSpeed": "$unit.label.windSpeed",
    "barometer": "$unit.label.barometer",
    "rain": "$unit.label.rain"
  },
## How temperature and wind are printed when a value is read off the chart:
## as the pages print them, which skin.conf makes whole numbers. The lines
## themselves are drawn from the figures as measured. Rounded points would
## make a line climb in steps.
  "formats": {
    "outTemp": "$unit.format.outTemp",
    "dewpoint": "$unit.format.dewpoint",
    "windSpeed": "$unit.format.windSpeed",
    "windGust": "$unit.format.windGust"
  },
  "series": {
    "outTemp":
#if $year.outTemp.has_data
$year.outTemp.series(aggregate_type='avg', aggregate_interval='day', time_series='start', time_unit='unix_epoch_ms').round(2).json
#else
[]
#end if
    ,
    "dewpoint":
#if $year.dewpoint.has_data
$year.dewpoint.series(aggregate_type='avg', aggregate_interval='day', time_series='start', time_unit='unix_epoch_ms').round(2).json
#else
[]
#end if
    ,
    "outHumidity":
#if $year.outHumidity.has_data
$year.outHumidity.series(aggregate_type='avg', aggregate_interval='day', time_series='start', time_unit='unix_epoch_ms').round(1).json
#else
[]
#end if
    ,
    "windSpeed":
#if $year.windSpeed.has_data
$year.windSpeed.series(aggregate_type='avg', aggregate_interval='day', time_series='start', time_unit='unix_epoch_ms').round(2).json
#else
[]
#end if
    ,
    "windGust":
#if $year.windGust.has_data
$year.windGust.series(aggregate_type='max', aggregate_interval='day', time_series='start', time_unit='unix_epoch_ms').round(2).json
#else
[]
#end if
    ,
    "barometer":
#if $year.barometer.has_data
$year.barometer.series(aggregate_type='avg', aggregate_interval='day', time_series='start', time_unit='unix_epoch_ms').round(3).json
#else
[]
#end if
    ,
    "rain":
#if $year.rain.has_data
$year.rain.series(aggregate_type='sum', aggregate_interval='day', time_series='start', time_unit='unix_epoch_ms').round(3).json
#else
[]
#end if

  }
}
